# Copy to wrangler.toml (gitignored) and fill in your own ids. See INSTALL.md.
name = "jane-learning"                      # Worker name → https://<name>.<your-subdomain>.workers.dev
main = "src/worker.js"
compatibility_date = "2025-09-01"
account_id = "<YOUR_CLOUDFLARE_ACCOUNT_ID>" # or delete this line and set CLOUDFLARE_ACCOUNT_ID
workers_dev = true

[assets]
directory = "./public"
binding = "ASSETS"
not_found_handling = "none"

[[kv_namespaces]]
binding = "JANE_KV"                       # the code expects this binding name
id = "<YOUR_KV_NAMESPACE_ID>"               # from: npx wrangler kv namespace create JANE_KV

# Learner settings (shown in the app, parent report and used by the nightly scripts).
[vars]
LEARNER_NAME = "Explorer"            # first name or nickname; kid-facing text uses {name} and this fills it in
LEARNER_AGE = "10"                   # target age for placement and topic choice (designed for ~7-12)
LEARNER_GRADE = "upper elementary"   # label used in the parent report and lesson-pack warnings; write it like "2nd grade" to follow a school profile
SCHOOL_PROFILE = "bvsd-high-peaks"   # optional: which data/school/*.json profile to follow (default: the only one). See docs/SCHOOL.md
